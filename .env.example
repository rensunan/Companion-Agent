# ============================================
# 陪伴智能体 - 环境变量模板
# 复制此文件为 .env 并填入真实值（不填则使用下面的免费默认通道）
# ============================================

# --- LLM 配置 ---
# 本地 Ollama 模型 (Echo-N1 或其他)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=Echo-N1

# API 后端（默认：免密钥的公开 OpenAI 兼容通道，免费但有速率限制）
# 想换成自己的服务，把下面三项改成你的即可，例如：
#   API_BASE_URL=https://open.bigmodel.cn/api/paas/v4   API_MODEL=glm-4-flash   API_KEY=你的key
API_BASE_URL=https://text.pollinations.ai/openai
API_KEY=sk-free-channel
API_MODEL=openai

# --- Embedding 配置 ---
# 本地: sentence-transformers 模型名
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# --- 记忆配置 ---
# 短期记忆保留最近多少轮对话
SHORT_TERM_MAX_TURNS=20
# 超过此轮数后触发摘要压缩
SUMMARY_TRIGGER_TURNS=15
# 向量检索时返回多少条记忆
MEMORY_RETRIEVAL_TOP_K=5

# --- 路径配置 ---
DATA_DIR=./data
